[Unit]
Description=检查后台手动备份请求（/opt/dc-ai-bot/data/backup-request.json），有请求就跑一次备份
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/dc-ai-bot/bin/backup-to-drive.sh --if-requested
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
