# 本地 `wrangler dev` 的变量示例：复制为 .dev.vars（已被 .gitignore 忽略）再填真实值。
# 真实凭据永不入库、永不写进 wrangler.toml；线上用 `wrangler secret put <NAME>` 注入。
DISCORD_BOT_TOKEN=<Discord 机器人 Token，Bot 页签的 Reset Token>
DISCORD_PUBLIC_KEY=<Discord 应用公钥，十六进制 64 字符>
DISCORD_APPLICATION_ID=<Discord 应用 ID，纯数字>
ADMIN_PASSWORD=<后台登录口令，自行设定>
SESSION_SECRET=<Cookie 签名密钥，至少 32 字符的随机串>
KEY_ENCRYPTION_SECRET=<32 字节随机数的 base64，用于 AES-256-GCM 加密厂商 API key>
