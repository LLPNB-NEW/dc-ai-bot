# 复制为 .env 再填真值：.env 已被 .gitignore 忽略，永远不要提交。
# 下面每个变量上面一句说明「填什么、能不能改」。

# Discord 机器人 Token（Bot 页签的 Reset Token）；只能由 Discord 侧轮换，改它必须同步改 Discord 后台。
DISCORD_BOT_TOKEN=
# Discord 应用公钥，十六进制 64 字符；跟 Discord 应用绑定，不可自造，只在 Discord 后台查看。
DISCORD_PUBLIC_KEY=
# Discord 应用 ID，纯数字；与公钥同源，不可自造。
DISCORD_APPLICATION_ID=
# 后台登录口令，自行设定；可以随时改，改完重启容器生效，已经发出去的会话 Cookie 不受影响。
ADMIN_PASSWORD=
# 会话 Cookie 的签名密钥，至少 32 字符随机串；可以改，代价是所有人被踢下线重登。
SESSION_SECRET=
# 厂商 API Key 的 AES-256-GCM 主密钥（32 字节随机数的 base64）。
# 必须与 Cloudflare 线上现用的值完全一致——改了或填错，库里已加密的 API Key 全部解不开，只能逐条重填。
KEY_ENCRYPTION_SECRET=

# 容器内监听端口；改了要同步改 Caddyfile 的 reverse_proxy 目标（bot:8787）。
PORT=8787
# SQLite 单文件路径；容器内必须落在 /data 下，因为只有 /data 是绑定挂载，别处重建容器就丢库。
DB_PATH=/data/dc-ai-bot.sqlite3
# Caddy 自动签发证书用的域名；换域名必须同步改 Cloudflare 上该记录指向本机 IP 的 A 记录。
SITE_ADDRESS=example.com
# ACME 账号邮箱，仅用于证书到期提醒；必填，留空会让 Caddyfile 全局块的 email 解析失败。
ACME_EMAIL=
